              "followups": [
                {
                  "kind": "question",
                  "id": "m4_1_urls",
                  "label": {
                    "en-GB": "URL or URLs"
                  },
                  "answerType": "text",
                  "visibleWhen": {
                    "field": "m4_1",
                    "equals": "urls"
