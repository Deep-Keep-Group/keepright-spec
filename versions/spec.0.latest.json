            "en-GB": "Details"
          },
          "items": [
            {
              "kind": "question",
              "id": "m3",
              "label": {
                "en-GB": "What should we call this material?"
              },
              "answerType": "text"
            },
            {
              "kind": "question",
              "id": "m4",
              "label": {
                "en-GB": "What is it?"
              },
              "answerType": "textarea",
              "ui": {
                "rows": 3
              }
            },
            {
              "kind": "question",
              "id": "m4_1",
              "label": {
                "en-GB": "Does it live online?"
              },
              "answerType": "radio",
              "options": [
                {
                  "value": "urls",
                  "label": {
                    "en-GB": "Yes, I have a URL or URLs"
                  }
                },
                {
                  "value": "ids",
                  "label": {
                    "en-GB": "Yes, I have some IDs (e.g. DOI)"
                  }
                },
                {
                  "value": "no",
                  "label": {
                    "en-GB": "No"
                  }
                }
              ],
              "visibleWhen": {
                "ref": "material_is_digital_or_both"
