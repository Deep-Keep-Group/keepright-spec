<?xml version="1.0" encoding="utf-8"?>
<keepRightSpec schemaVersion="0.0.1" specVersion="0.0.2" release="pre-alpha" locale="en-GB">
  <title>KeepRight Spec</title>
  <logic>
    <conditions>
      <condition id="material_is_digital_or_both">
        <any>
          <condition>
            <fieldCondition field="m1" equals="digital"/>
          </condition>
          <condition>
            <fieldCondition field="m1" equals="both"/>
          </condition>
        </any>
      </condition>
      <condition id="material_is_physical_or_both">
        <any>
          <condition>
            <fieldCondition field="m1" equals="physical"/>
          </condition>
          <condition>
            <fieldCondition field="m1" equals="both"/>
          </condition>
        </any>
      </condition>
      <condition id="copyright_holder_yes_or_unsure">
        <any>
          <condition>
            <fieldCondition field="m2" equals="yes"/>
          </condition>
          <condition>
            <fieldCondition field="m2" equals="not_sure"/>
          </condition>
        </any>
      </condition>
    </conditions>
  </logic>
