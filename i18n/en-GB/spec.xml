    <section id="material">
      <title>The Material</title>
      <items>
        <item id="material_crux" kind="group">
          <title>Crux</title>
          <items>
            <item id="m1" kind="question" answerType="radio" displayCode="M1">
              <label>Is this digital, physical, or both?</label>
              <options>
                <option value="digital">
                  <label>Digital</label>
                </option>
                <option value="physical">
                  <label>Physical</label>
                </option>
                <option value="both">
                  <label>Both</label>
                </option>
              </options>
            </item>
            <item id="m2" kind="question" answerType="radio" displayCode="M2">
              <label>Are you the copyright holder?</label>
              <options>
                <option value="yes">
                  <label>Yes</label>
                </option>
                <option value="no">
                  <label>No</label>
                </option>
                <option value="not_sure">
                  <label>Not sure</label>
                </option>
              </options>
            </item>
          </items>
        </item>
        <item id="material_details" kind="group">
          <title>Details</title>
          <items>
            <item id="m3" kind="question" answerType="text" displayCode="M3">
              <label>What should we call this material?</label>
            </item>
            <item id="m4" kind="question" answerType="textarea" displayCode="M4">
              <label>What is it?</label>
              <ui>
                <rows>3</rows>
              </ui>
            </item>
            <item id="m4_1" kind="question" answerType="radio" displayCode="M4.1">
              <label>Does it live online?</label>
              <visibleWhen>
                <ref>material_is_digital_or_both</ref>
              </visibleWhen>
              <options>
                <option value="urls">
                  <label>Yes, I have a URL or URLs</label>
                </option>
                <option value="ids">
                  <label>Yes, I have some IDs (e.g. DOI)</label>
                </option>
                <option value="no">
                  <label>No</label>
                </option>
              </options>
              <followups>
                <item id="m4_1_urls" kind="question" answerType="text">
                  <label>URL or URLs</label>
                  <placeholder>Paste URLs here</placeholder>
                  <visibleWhen>
                    <fieldCondition field="m4_1" equals="urls"/>
                  </visibleWhen>
                </item>
                <item id="m4_1_ids" kind="question" answerType="text">
                  <label>IDs</label>
                  <placeholder>Paste IDs here</placeholder>
                  <visibleWhen>
                    <fieldCondition field="m4_1" equals="ids"/>
                  </visibleWhen>
                </item>
              </followups>
            </item>
            <item id="m4_2" kind="question" answerType="text" displayCode="M4.2">
              <label>Which file formats or file extensions are involved?</label>
              <placeholder>e.g. jpg, pdf, wav</placeholder>
              <visibleWhen>
                <ref>material_is_digital_or_both</ref>
              </visibleWhen>
            </item>
            <item id="m5" kind="question" answerType="checkboxes" displayCode="M5">
              <label>What's your relationship to it?</label>
              <options>
                <option value="made">
                  <label>I made it</label>
                </option>
                <option value="own">
                  <label>I own it</label>
                </option>
                <option value="family">
                  <label>I'm a family member of the creator</label>
                </option>
                <option value="steward">
                  <label>I'm a designated steward</label>
                </option>
                <option value="community">
                  <label>I'm a community member</label>
                </option>
                <option value="let_me_tell_you">
                  <label>Let me tell you...</label>
                </option>
              </options>
              <followups>
                <item id="m5_let_me_tell_you_detail" kind="question" answerType="textarea">
                  <label>Tell us more</label>
                  <visibleWhen>
                    <fieldCondition field="m5" contains="let_me_tell_you"/>
                  </visibleWhen>
                  <ui>
                    <rows>2</rows>
                  </ui>
                </item>
              </followups>
            </item>
            <item id="m6" kind="question" answerType="textarea" displayCode="M6">
              <label>Who made this, and who owns it now?</label>
              <ui>
                <rows>3</rows>
              </ui>
            </item>
            <item id="m7" kind="question" answerType="radio" displayCode="M7">
              <label>What's its copyright or licensing status, if you know?</label>
              <options>
                <option value="all_rights_reserved">
                  <label>All Rights Reserved</label>
                </option>
                <option value="open_license">
                  <label>Open License (e.g. Creative Commons)</label>
                </option>
                <option value="public_domain">
                  <label>Public Domain</label>
                </option>
                <option value="not_sure">
                  <label>Not sure</label>
                </option>
                <option value="complicated">
                  <label>It's complicated...</label>
                </option>
              </options>
              <followups>
                <item id="m7_complicated_detail" kind="question" answerType="textarea">
                  <label>Tell us more</label>
                  <visibleWhen>
                    <fieldCondition field="m7" equals="complicated"/>
                  </visibleWhen>
                  <ui>
                    <rows>2</rows>
                  </ui>
                </item>
              </followups>
            </item>
            <item id="m8" kind="question" answerType="textarea" displayCode="M8">
              <label>Can you add any background on how, why, or when it was made? This will help future stewards understand the material.</label>
              <optionalLabel>optional</optionalLabel>
              <ui>
                <rows>5</rows>
              </ui>
            </item>
          </items>
        </item>
      </items>
    </section>
    <section id="keep_right">
      <title>Keep Right</title>
      <items>
        <item id="machine_right_note" kind="note">
          <text>One line description for a facet.</text>
        </item>
        <item id="kr1" kind="question" answerType="checkboxes" displayCode="KR1">
          <label>Who would you like to take care of this?</label>
          <options>
            <option value="person">
              <label>A specific person</label>
            </option>
            <option value="institution">
              <label>A specific institution</label>
            </option>
            <option value="any_archive_or_library">
              <label>Any qualified archive or library</label>
            </option>
            <option value="any_steward">
              <label>Open to any steward</label>
            </option>
            <option value="it_depends">
              <label>It depends...</label>
            </option>
          </options>
          <followups>
