            {
              "id": "m5",
              "kind": "question",
              "answerType": "checkboxes",
              "displayCode": "M5",
              "label": {
                "en-GB": "What's your relationship to it?"
              },
              "options": [
                { "value": "made", "label": { "en-GB": "I made it" } },
                { "value": "own", "label": { "en-GB": "I own it" } },
                { "value": "family", "label": { "en-GB": "I'm a family member of the creator" } },
                { "value": "steward", "label": { "en-GB": "I'm a designated steward" } },
                { "value": "community", "label": { "en-GB": "I'm a community member" } },
                { "value": "let_me_tell_you", "label": { "en-GB": "Let me tell you..." } }
              ],
              "followups": [
                {
                  "id": "m5_let_me_tell_you_detail",
                  "kind": "question",
                  "answerType": "textarea",
                  "label": {
                    "en-GB": "Tell us more"
                  },
                  "visibleWhen": {
                    "field": "m5",
                    "contains": "let_me_tell_you"
                  },
                  "ui": {
                    "rows": 2
                  }
                }
              ]
            },
            {
              "id": "m6",
              "kind": "question",
              "answerType": "textarea",
              "displayCode": "M6",
              "label": {
                "en-GB": "Who made this, and who owns it now?"
