            {
              "id": "m4_1",
              "kind": "question",
              "answerType": "radio",
              "displayCode": "M4.1",
              "label": {
                "en-GB": "Does it live online?"
              },
              "visibleWhen": {
                "ref": "material_is_digital_or_both"
              },
              "options": [
                { "value": "urls", "label": { "en-GB": "Yes, I have a URL or URLs" } },
                { "value": "ids", "label": { "en-GB": "Yes, I have some IDs (e.g. DOI)" } },
                { "value": "no", "label": { "en-GB": "No" } }
              ],
              "followups": [
                {
                  "id": "m4_1_urls",
                  "kind": "question",
                  "answerType": "text",
                  "label": {
                    "en-GB": "URL or URLs"
                  },
                  "placeholder": {
                    "en-GB": "Paste URLs here"
