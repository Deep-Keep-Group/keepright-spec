        "en-GB": "The Material"
      },
      "items": [
        {
          "id": "material_crux",
          "kind": "group",
          "title": {
            "en-GB": "Crux"
          },
          "items": [
            {
              "id": "m1",
              "kind": "question",
              "answerType": "radio",
              "displayCode": "M1",
              "label": {
                "en-GB": "Is this digital, physical, or both?"
              },
              "options": [
                { "value": "digital", "label": { "en-GB": "Digital" } },
                { "value": "physical", "label": { "en-GB": "Physical" } },
                { "value": "both", "label": { "en-GB": "Both" } }
              ]
            },
            {
              "id": "m2",
              "kind": "question",
              "answerType": "radio",
              "displayCode": "M2",
              "label": {
                "en-GB": "Are you the copyright holder?"
              },
              "options": [
                { "value": "yes", "label": { "en-GB": "Yes" } },
                { "value": "no", "label": { "en-GB": "No" } },
                { "value": "not_sure", "label": { "en-GB": "Not sure" } }
              ]
            }
          ]
        },
        {
          "id": "material_details",
          "kind": "group",
          "title": {
            "en-GB": "Details"
