              "options": [
                { "value": "all_rights_reserved", "label": { "en-GB": "All Rights Reserved" } },
                { "value": "open_license", "label": { "en-GB": "Open License (e.g. Creative Commons)" } },
                { "value": "public_domain", "label": { "en-GB": "Public Domain" } },
                { "value": "not_sure", "label": { "en-GB": "Not sure" } },
                { "value": "complicated", "label": { "en-GB": "It's complicated..." } }
