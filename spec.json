              "followups": [
                {
                  "id": "m7_complicated_detail",
                  "kind": "question",
                  "answerType": "textarea",
                  "label": {
                    "en-GB": "Tell us more"
                  },
                  "visibleWhen": {
                    "field": "m7",
                    "equals": "complicated"
                  },
                  "ui": {
                    "rows": 2
                  }
                }
              ]
            },
            {
              "id": "m8",
              "kind": "question",
              "answerType": "textarea",
              "displayCode": "M8",
              "label": {
