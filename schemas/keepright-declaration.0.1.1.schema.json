{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keepright.info/schemas/keepright-declaration.schema.json",
  "title": "KeepRight Declaration",
  "type": "object",
  "required": ["id", "createdAt", "spec", "answers"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "spec": { "$ref": "#/$defs/specSnapshot" },
    "answers": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "$ref": "#/$defs/answer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "specSnapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "specVersion",
        "release",
        "locale",
        "repo",
        "fetchedAt"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/semver" },
        "specVersion": { "$ref": "#/$defs/semver" },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "locale": { "$ref": "#/$defs/locale" },
        "repo": { "$ref": "#/$defs/repoSnapshot" },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "repoSnapshot": {
      "type": "object",
      "required": ["owner", "name", "ref", "path", "sourceUrl"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "answerType": {
      "enum": ["text", "email", "textarea", "radio", "checkboxes", "select"]
    },
    "answer": {
      "type": "object",
      "required": ["question", "label", "answerType", "value", "answerLabels"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "answerType": { "$ref": "#/$defs/answerType" },
        "value": true,
        "answerLabels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "answerType": { "const": "checkboxes" }
            },
            "required": ["answerType"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
